	<string>The app uses Bluetooth to communicate with your COLMI smart ring.</string>
	<key>NSCameraUsageDescription</key>
	<string>The app uses the camera to scan physical health documents (lab results, prescriptions) and extract their text.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>The app needs photo access to select existing document scans when the camera is unavailable.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
