//
// Shared.xcconfig.example
//
// Build-time configuration for the HealthTip macOS app and its widget. Copy
// this file to `Shared.xcconfig`, fill in the values, and keep
// `Shared.xcconfig` gitignored — the real device key never gets committed.
//
// xcconfig treats `//` as a line comment, so scheme and host are split and
// reassembled in each Info.plist via `$(APP_BACKEND_SCHEME)://$(APP_BACKEND_HOST)`.

APP_BACKEND_SCHEME = https
APP_BACKEND_HOST = grig-teo.space
APP_DEVICE_KEY = change-me
