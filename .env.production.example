DOMAIN=grig-teo.space
SITE_URL=https://grig-teo.space
CORS_ORIGIN=https://grig-teo.space,https://www.grig-teo.space
CERTBOT_EMAIL=your-email@example.com
NEXT_PUBLIC_API_URL=

# Database (generated on first deploy — do not commit real values)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://grigteo:change-me@db:5432/grigteo

# Admin panel auth (generated on first deploy — do not commit real values)
ADMIN_ACCESS_KEY=change-me
JWT_SECRET=change-me

# MinIO media storage (generated on first deploy — do not commit real values)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=grig-teo-media
MINIO_PUBLIC_URL=https://grig-teo.space/media

# AI assistant
DEEPSEEK_API_KEY=change-me
DEEPSEEK_MODEL=deepseek-chat

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=change-me
LINKEDIN_CLIENT_SECRET=change-me
LINKEDIN_REDIRECT_URI=https://grig-teo.space/api/linkedin/callback

# Health pipeline (COLMI ring ingest from iOS app + Telegram bot)
DEVICE_API_KEY=change-me

# Telegram bot (creates @BotFather token; TELEGRAM_CHAT_ID is your numeric user id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Records AI doctor (GLM-5.2 over Z.ai) — scans documents and answers health questions
GLM_API_KEY=
GLM_MODEL=glm-5.2
