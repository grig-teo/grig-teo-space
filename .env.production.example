DOMAIN=grig-teo.space
SITE_URL=https://grig-teo.space
CORS_ORIGIN=https://grig-teo.space,https://www.grig-teo.space
CERTBOT_EMAIL=your-email@example.com
NEXT_PUBLIC_API_URL=

# Database (generated on first deploy — do not commit real values)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://grigteo:change-me@db:5432/grigteo

# Admin panel auth (generated on first deploy — do not commit real values)
ADMIN_ACCESS_KEY=change-me
JWT_SECRET=change-me

# MinIO media storage (generated on first deploy — do not commit real values)
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=grig-teo-media
MINIO_PUBLIC_URL=https://grig-teo.space/media
# Private bucket for personal photo/video backups — never served publicly.
MINIO_PRIVATE_BUCKET=grig-teo-media-private

# AI assistant
DEEPSEEK_API_KEY=change-me
DEEPSEEK_MODEL=deepseek-chat

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=change-me
LINKEDIN_CLIENT_SECRET=change-me
LINKEDIN_REDIRECT_URI=https://grig-teo.space/api/linkedin/callback

# Health pipeline (COLMI ring ingest from iOS app + Telegram bot)
DEVICE_API_KEY=change-me

# Telegram bot (creates @BotFather token; TELEGRAM_CHAT_ID is your numeric user id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Records AI doctor (GLM-5.2 over Z.ai) — scans documents and answers health questions
GLM_API_KEY=***
GLM_MODEL=glm-5.2

# ----------------------------------------------------------------------------
# Off-server backups (deploy/backup.sh, nightly via grigteo-backup.timer)
# Docs: deploy/RESTORE.md. The ONLY manual setup is the encryption key + an
# off-box target — do NOT back up into this same VPS/MinIO.
#
# 1) Generate an age key pair OFF the VPS (keep the PRIVATE half in a password
#    manager — losing it loses all backups):
#       age-keygen -o backup-key.txt
#    That prints "# public key: age1xxxx..."  -> paste the recipient below.
BACKUP_AGE_RECIPIENT=age1

# 2) Transport: rsync (default, any ssh target) or rclone (B2/S3/Hetzner/etc).
BACKUP_TRANSPORT=rsync
BACKUP_RETENTION_DAYS=30

# rsync target (used when BACKUP_TRANSPORT=rsync). E.g. a Hetzner Storage Box
# (u123456@u123456.your-storagebox.de:/home/backups/grigteo) or any second host
# reachable by ssh key.
BACKUP_RSYNC_HOST=user@storage.example.com
BACKUP_RSYNC_PATH=/srv/backups/grigteo
BACKUP_RSYNC_PORT=
BACKUP_RSYNC_IDENTITY=

# rclone target (used when BACKUP_TRANSPORT=rclone). Configure the remote on the
# VPS with `rclone config`, then name it here, e.g. b2:grigteo-backups
BACKUP_RCLONE_REMOTE=
