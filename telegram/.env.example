# Telegram bot token from @BotFather (talk to @BotFather, /newbot)
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id (message @userinfobot to learn yours)
TELEGRAM_CHAT_ID=

# Shared device key — must match DEVICE_API_KEY on the backend
DEVICE_API_KEY=dev-device-key

# Backend URL (from the bot container use http://backend:3001; locally use http://localhost:3001)
TELEGRAM_BACKEND_URL=http://localhost:3001

# Hour (0-23, local to the container) at which the daily digest is sent
DIGEST_HOUR=9

# How often (minutes) to poll the summary for anomaly alerts
ALERT_POLL_MINUTES=15
